# Copie para server/.env e preencha. O .env NUNCA vai para o git.
# Em produção, estas variáveis ficam no painel da plataforma (Railway/Fly), não num arquivo.

# Provedor de LLM: openai | anthropic
LLM=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Confira os modelos disponíveis na documentação do provedor.
# Em produção, prefira um snapshot com data em vez do alias.
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-5
EMBEDDING_MODEL=text-embedding-3-small

# Segredo para assinar os tokens JWT. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

CHROMA_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379

PORT=3000
RATE_LIMIT_POR_MINUTO=10

# Opcional: exige "Authorization: Bearer <token>" em /api/metrics (recomendado em produção)
METRICS_TOKEN=
LOG_LEVEL=info
