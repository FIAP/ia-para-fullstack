# Copie para .env e preencha. O .env NUNCA vai para o git.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Qual provedor usar: openai | anthropic
LLM=openai

# Confira os modelos disponíveis na documentação do provedor.
# Em produção, prefira um snapshot com data (ex.: gpt-4.1-mini-2025-04-14):
# o alias sem data pode apontar para outra versão sem aviso e mudar o comportamento.
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-5

PORT=3000
